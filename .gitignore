# Python environments and generated files
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Local credentials and environment
.env
.env.*
!.env.example
*.key
*.pem

# Private internals; prevents accidental plain-file imports.
# The submodule gitlink, once registered, is tracked separately.
old/

# Bluetooth Mesh runtime state, captures, logs, and secrets
state/

# App-local agent metadata
.agents/
.codex/

# The user's global ignore file suppresses these by default.
!.gitignore
